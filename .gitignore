# 上游 PI 项目的本地参考副本，仅供人工比对，不是构建输入
/sample/

# MaaFramework 的 Android 产物：与 PI 同理不进仓库，由 scripts/setup_maa_framework.py 拉取
/app/src/main/jniLibs/
/.maa-cache/
/.maafwversion

# build_agent_bundle.py 的工作目录：下载的 agent 内核、解包结果与 pip 缓存
/.maafw/
# 出内核用的下载缓存；内核脚本不在本仓库，这条只为本机残留的目录留着
.agent-runtime-cache/

# Kotlin 2.x 的构建缓存目录
.kotlin/

# Python 缓存
__pycache__/
*.py[cod]

# build_agent_bundle.py 的最终产物（Python agent 运行时，体积大，按 INTEGRATION.md 重新构建）
/agent-dist/

# 本机重定向的 Gradle / AppData 缓存目录与临时目录
/.gradle-home/
/.local-appdata/
/.tmp/

# 本机打包脚本（硬编码绝对路径）与构建输出
/run_build*.bat
/build_result.txt
/build_final.txt

# 具体打包配方（含业务标识、本地路径、包名等）不进仓库，仅保留接入样例
/pi-profile-*.yaml
/*-profile.yaml
!/pi-profile.sample.yaml
