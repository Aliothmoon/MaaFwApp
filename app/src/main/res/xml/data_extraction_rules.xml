<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ 的云备份与设备迁移规则
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- 录制的解锁手势等价于锁屏凭证，且按本机屏幕录制，不进备份也不随换机迁移 -->
    <cloud-backup>
        <exclude domain="file" path="unlock/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="unlock/" />
    </device-transfer>
</data-extraction-rules>
